<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Tuần 6: Custom cell cho ListView - mỗi download item -->
<!-- Note: Controller được set manually trong DownloadCellController.updateItem() -->
<HBox xmlns:fx="http://javafx.com/fxml/1" alignment="CENTER_LEFT" spacing="10">
    <padding>
        <Insets bottom="5" left="10" right="10" top="5"/>
    </padding>

    <!-- File info và progress bars -->
    <!-- File info và progress bars -->
    <VBox HBox.hgrow="ALWAYS" spacing="5">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label fx:id="fileNameLabel" text="File Name" styleClass="source-label" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Label fx:id="progressLabel" text="0%" style="-fx-font-weight: bold; -fx-text-fill: #2196F3;"/>
        </HBox>
        
        <ProgressBar fx:id="progressBar" prefWidth="400.0" progress="0.0" styleClass="overall-progress" maxWidth="Infinity"/>
        
        <HBox alignment="CENTER_LEFT">
             <Label fx:id="detailsLabel" text="0 MB/s | ETA: -- | 0 MB / 0 MB" style="-fx-font-size: 11px; -fx-text-fill: #666666;"/>
        </HBox>
        
        <!-- Per-source progress bars -->
        <VBox spacing="3">
            <HBox spacing="5" alignment="CENTER_LEFT">
                <Label text="Origin:" minWidth="60"/>
                <ProgressBar fx:id="originProgressBar" prefWidth="150.0" progress="0.0" styleClass="origin-progress"/>
                <Label fx:id="originLabel" text="0 B" minWidth="50"/>
            </HBox>
            <HBox spacing="5" alignment="CENTER_LEFT">
                <Label text="Mirror:" minWidth="60"/>
                <ProgressBar fx:id="mirrorProgressBar" prefWidth="150.0" progress="0.0" styleClass="mirror-progress"/>
                <Label fx:id="mirrorLabel" text="0 B" minWidth="50"/>
            </HBox>
            <HBox spacing="5" alignment="CENTER_LEFT">
                <Label text="Peers:" minWidth="60"/>
                <ProgressBar fx:id="peerProgressBar" prefWidth="150.0" progress="0.0" styleClass="peer-progress"/>
                <Label fx:id="peerLabel" text="0 B" minWidth="50"/>
            </HBox>
        </VBox>
    </VBox>

    <!-- Status label -->
    <Label fx:id="statusLabel" text="Status" minWidth="80"/>

    <!-- Tuần 6: Pause/Resume buttons -->
    <HBox alignment="CENTER" spacing="5.0">
        <Button fx:id="playButton" onAction="#handlePlay" text="▶ Play" disable="true"/>
        <Button fx:id="pauseButton" onAction="#handlePause" text="Pause"/>
        <Button fx:id="resumeButton" onAction="#handleResume" text="Resume" disable="true"/>
    </HBox>
</HBox>

