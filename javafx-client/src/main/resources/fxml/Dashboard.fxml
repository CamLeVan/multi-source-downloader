<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!-- Dashboard với Download Manager UI -->
<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fragmented.download.javafx.controller.DashboardController"
      spacing="15.0" styleClass="dashboard">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <!-- Title -->
    <Label text="Multi-Source Download Manager" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <!-- File Selection Section -->
    <VBox spacing="10.0" style="-fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 5; -fx-padding: 15;">
        <Label text="Select or Enter File to Download:" style="-fx-font-weight: bold;"/>
        
        <!-- ComboBox để chọn file có sẵn -->
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <Label text="Available Files:" minWidth="100"/>
            <ComboBox fx:id="fileComboBox" promptText="Select a file..." prefWidth="300.0" HBox.hgrow="ALWAYS"/>
            <Button fx:id="refreshButton" text="Refresh" onAction="#onRefreshFiles"/>
        </HBox>
        
        <!-- TextField để nhập custom file name -->
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <Label text="Or Enter File:" minWidth="100"/>
            <TextField fx:id="fileNameField" promptText="e.g., 100MB.zip" prefWidth="300.0" HBox.hgrow="ALWAYS"/>
        </HBox>
        
        <!-- Button để bắt đầu download -->
        <HBox spacing="10.0" alignment="CENTER">
            <Button fx:id="addDownloadButton" text="Add Download" onAction="#onAddDownload" 
                    style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10px 30px;"/>
        </HBox>
    </VBox>

    <!-- Downloads Queue Section -->
    <VBox spacing="5.0" VBox.vgrow="ALWAYS">
        <Label text="Download Queue:" style="-fx-font-weight: bold;"/>
        <ListView fx:id="downloadListView" prefHeight="300.0" VBox.vgrow="ALWAYS"/>
    </VBox>

    <!-- Status Bar -->
    <HBox spacing="10.0" style="-fx-background-color: #f5f5f5; -fx-padding: 10;">
        <Label fx:id="statusLabel" text="Ready" style="-fx-font-size: 12px;"/>
    </HBox>

</VBox>
