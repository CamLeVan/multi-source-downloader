<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<!-- Tuần 6: Dashboard với ListView để hiển thị nhiều downloads -->
<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fragmented.download.javafx.controller.DashboardController"
      alignment="CENTER" spacing="10.0" styleClass="dashboard">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <!-- Tuần 6: ListView hiển thị download queue với drag & drop -->
    <ListView fx:id="downloadListView" prefHeight="400.0" prefWidth="700.0" VBox.vgrow="ALWAYS"/>

    <!-- Tuần 6: Drop zone cho việc kéo thả link (optional - WebView) -->
    <Label fx:id="dropLabel" text="Drag and drop a download link here"
           style="-fx-border-color: #c6c6c6; -fx-border-width: 2; -fx-border-style: dashed; -fx-padding: 20px;"/>

</VBox>
