<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.fragmented.download.admin.controller.StatisticsController"
      spacing="20"
      styleClass="statistics-container">
    
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    
    <Label text="Statistics &amp; Analytics" styleClass="section-title"/>
    
    <VBox spacing="15">
        <Label text="Coming Soon..." styleClass="info-text"/>
        <Label text="This section will display:" styleClass="info-text"/>
        <Label text="• Download analytics" styleClass="info-text"/>
        <Label text="• Bandwidth usage charts" styleClass="info-text"/>
        <Label text="• Peer activity over time" styleClass="info-text"/>
        <Label text="• Top downloaded files" styleClass="info-text"/>
    </VBox>
    
</VBox>

