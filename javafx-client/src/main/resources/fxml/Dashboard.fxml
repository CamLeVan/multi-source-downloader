<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fragmented.download.javafx.controller.DashboardController"
      alignment="CENTER" spacing="15.0" styleClass="dashboard">

    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
    </padding>

    <!-- Overall Progress -->
    <Label text="Overall Download Progress" styleClass="title-label"/>
    <ProgressBar fx:id="overallProgressBar" prefWidth="600.0" progress="0.0" styleClass="overall-progress"/>

    <!-- Tuần 2: Per-Source Progress Bars với CSS Gradient -->
    <Label text="Origin Server" styleClass="source-label"/>
    <ProgressBar fx:id="originProgressBar" prefWidth="600.0" progress="0.0" styleClass="origin-progress"/>

    <Label text="Mirror Server" styleClass="source-label"/>
    <ProgressBar fx:id="mirrorProgressBar" prefWidth="600.0" progress="0.0" styleClass="mirror-progress"/>

    <Label text="P2P Peers" styleClass="source-label"/>
    <ProgressBar fx:id="peerProgressBar" prefWidth="600.0" progress="0.0" styleClass="peer-progress"/>

</VBox>
