<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Tuần 6: Custom cell cho ListView - mỗi download item -->
<HBox xmlns:fx="http://javafx.com/fxml/1" alignment="CENTER_LEFT" spacing="10"
      fx:controller="com.fragmented.download.javafx.controller.DownloadCellController">
    <padding>
        <Insets bottom="5" left="10" right="10" top="5"/>
    </padding>

    <!-- File info và progress bar -->
    <VBox HBox.hgrow="ALWAYS">
        <Label fx:id="fileNameLabel" text="File Name" styleClass="source-label"/>
        <ProgressBar fx:id="progressBar" prefWidth="400.0" progress="0.0" styleClass="overall-progress"/>
    </VBox>

    <!-- Status label -->
    <Label fx:id="statusLabel" text="Status" minWidth="80"/>

    <!-- Tuần 6: Pause/Resume buttons -->
    <HBox alignment="CENTER" spacing="5.0">
        <Button fx:id="pauseButton" onAction="#handlePause" text="Pause"/>
        <Button fx:id="resumeButton" onAction="#handleResume" text="Resume" disable="true"/>
    </HBox>
</HBox>

